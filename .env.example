# Copy to the right place and fill in. Never commit real values.
# ---------- apps/api/.env (server-side secrets) ----------
# Supabase dashboard > Connect > Pooler, SESSION mode (port 5432). URL-encode special characters in the password.
# Scheme must be postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
ALLOWED_ORIGINS=http://localhost:3000

LLM_PROVIDER=gemini
LLM_API_KEY=
# Use model ids currently available to your key; never hard-code them in code.
LLM_MODEL_PATIENT=
LLM_MODEL_EVALUATOR=
EMBEDDING_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# ---------- apps/web/.env.local (public by design: no secrets here) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A Supabase secret / service_role key must NEVER be placed in apps/web or in any NEXT_PUBLIC_ variable.
