# Copy to the right place and fill in. Never commit real values.
# ---------- apps/api/.env (server-side secrets) ----------
# Supabase dashboard > Connect > Pooler, SESSION mode (port 5432). URL-encode special characters in the password.
# Scheme must be postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Bearer JWTs are verified against the public JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (asymmetric signing keys: RS256/ES256). Unset SUPABASE_URL = guest-only (bearer tokens refused).
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_S=600
# Privacy (Slice 13). SERVER-SIDE ONLY: a Supabase secret key lets DELETE /api/v1/me also delete
# the Supabase Auth user. NEVER put it in apps/web, in any NEXT_PUBLIC_ variable, in logs or commits.
# SUPABASE_SECRET_KEY=
# Guest sessions older than N days are deleted by `python -m avp_api.jobs.cleanup` (not scheduled
# automatically). 30 is a proposed default pending a team decision (OPEN_QUESTIONS Q7).
GUEST_RETENTION_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000
# Public web origin encoded in the practice-report QR code (no secrets in it).
WEB_BASE_URL=http://localhost:3000

LLM_PROVIDER=gemini
LLM_API_KEY=
# Use model ids currently available to your key; never hard-code them in code.
LLM_MODEL_PATIENT=
LLM_MODEL_EVALUATOR=
EMBEDDING_MODEL=
# Voice (Slice 6). Leave PROVIDER empty to use the offline Fake adapters.
# Supported real provider: google (Cloud Speech-to-Text / Text-to-Speech, API key).
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=vi-VN
STT_TIMEOUT_S=8
TTS_PROVIDER=
TTS_API_KEY=
# Voice name available to your key (e.g. a vi-VN voice); never hard-coded in code.
TTS_VOICE_ID=
TTS_LANGUAGE=vi-VN
TTS_TIMEOUT_S=8
# Exam (OSCE) mode time limit in seconds; blank = no limit (undecided, OPEN_QUESTIONS Q9).
EXAM_TIME_LIMIT_S=

# ---------- apps/web/.env.local (public by design: no secrets here) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A Supabase secret / service_role key must NEVER be placed in apps/web or in any NEXT_PUBLIC_ variable.
