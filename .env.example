# Copy to the right place and fill in. Never commit real values.
# ---------- apps/api/.env (server-side secrets) ----------
# Supabase dashboard > Connect > Pooler, SESSION mode (port 5432). URL-encode special characters in the password.
# Scheme must be postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Bearer JWTs are verified against the public JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (asymmetric signing keys: RS256/ES256). Unset SUPABASE_URL = guest-only (bearer tokens refused).
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_S=600
# Privacy (Slice 13). SERVER-SIDE ONLY: a Supabase secret key lets DELETE /api/v1/me also delete
# the Supabase Auth user. NEVER put it in apps/web, in any NEXT_PUBLIC_ variable, in logs or commits.
# SUPABASE_SECRET_KEY=
# Guest sessions older than N days are deleted by `python -m avp_api.jobs.cleanup` (not scheduled
# automatically). 30 is a proposed default pending a team decision (OPEN_QUESTIONS Q7).
GUEST_RETENTION_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000
# Public web origin encoded in the practice-report QR code (no secrets in it).
WEB_BASE_URL=http://localhost:3000

LLM_PROVIDER=gemini
LLM_API_KEY=
# Use model ids currently available to your key; never hard-code them in code.
# Google retires ids (gemini-1.5-*, text-embedding-004 are gone; a free-tier key has
# 0 quota for Pro models). Check them with `make check-llm` before a demo.
# Example that works on a free-tier key (Nov 2026):
#   LLM_MODEL_PATIENT=gemini-3.5-flash
#   LLM_MODEL_EVALUATOR=gemini-3.5-flash
#   LLM_MODEL_EVALUATOR_FALLBACK=gemini-3.1-flash-lite
#   EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL_PATIENT=
LLM_MODEL_EVALUATOR=
# Used for scoring and debriefs only when the evaluator model is overloaded (503)
# or out of quota (429) after retries. Leave empty for no fallback.
LLM_MODEL_EVALUATOR_FALLBACK=
# Patient model used when LLM_MODEL_PATIENT is rate-limited (429) or overloaded (503).
# Pick a DIFFERENT model: Gemini quotas are per model, so the fallback has its own.
LLM_MODEL_PATIENT_FALLBACK=
# Optional key from another Google project for scoring/debrief only (its own quota).
# Blank = LLM_API_KEY.
LLM_API_KEY_EVALUATOR=
# Longest total wait (seconds) for retries on 429/5xx before switching to the fallback
# (or failing). The Patient path is short because the student is waiting.
LLM_PATIENT_MAX_RETRY_WAIT_S=2
LLM_EVALUATOR_MAX_RETRY_WAIT_S=30
# Seconds before a Gemini request is abandoned (then retried or sent to the fallback).
LLM_TIMEOUT_S=60
# Same, for one Patient reply (hot path, the student is waiting): a stuck call is
# cut here and handed to LLM_MODEL_PATIENT_FALLBACK when that is set.
LLM_PATIENT_TIMEOUT_S=15
# Changing EMBEDDING_MODEL means re-running `python scripts/ingest_guidelines.py`
# (chunks are stored per model; old ones no longer match).
EMBEDDING_MODEL=
# Voice (Slice 6). Leave PROVIDER empty to use the offline Fake adapters.
# Supported real providers: google (Cloud Speech-to-Text / Text-to-Speech, API key);
# for STT also whisper (self-hosted Whisper, free, no account: see README "Micro");
# for TTS also vieneu (self-hosted VieNeu-TTS, free, no account: see README "Giọng nói").
STT_PROVIDER=
# google: the API key. whisper: optional, only if the STT server requires a Bearer key.
STT_API_KEY=
# whisper only: the STT server root, e.g. http://127.0.0.1:8890 (not 8000: that is this API).
STT_BASE_URL=
# google: a model available to your key. whisper: optional model name sent to the server.
STT_MODEL=
STT_LANGUAGE=vi-VN
# whisper on CPU: allow more time for long questions (e.g. 30).
STT_TIMEOUT_S=8
TTS_PROVIDER=
# google: the API key. vieneu: optional, only if the VieNeu server sets VIENEU_API_KEY.
TTS_API_KEY=
# vieneu only: the VieNeu server root, e.g. http://127.0.0.1:8880 (not 8000: that is this API).
TTS_BASE_URL=
# google: a voice name available to your key. vieneu: a preset voice name (GET /v1/voices);
# blank = the server's default voice. Never hard-coded in code.
TTS_VOICE_ID=
TTS_LANGUAGE=vi-VN
# vieneu on CPU synthesizes the whole reply before sending it: allow more time (e.g. 30).
TTS_TIMEOUT_S=8
# Read only by run.bat (not the API): where VieNeu-TTS is installed, and where its
# model downloads (HF_HOME; use another drive if C: is short on space). No quotes.
VIENEU_DIR=
VIENEU_HF_HOME=
# Read only by run.bat (not the API), for STT_PROVIDER=whisper: the python.exe of the
# local STT server's virtualenv, and where its model downloads (HF_HOME). No quotes.
STT_SERVER_PYTHON=
STT_HF_HOME=
# Read only by run.bat, passed to the STT server as WHISPER_DEVICE / _COMPUTE_TYPE /
# _BEAM_SIZE. Blank = CPU, int8, beam 5. NVIDIA GPU (see README "Micro"): cuda,
# int8_float16, 1, with STT_MODEL=large-v3-turbo.
STT_DEVICE=
STT_COMPUTE_TYPE=
STT_BEAM_SIZE=
# Exam (OSCE) mode time limit in seconds; blank = no limit (undecided, OPEN_QUESTIONS Q9).
EXAM_TIME_LIMIT_S=

# ---------- apps/web/.env.local (public by design: no secrets here) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A Supabase secret / service_role key must NEVER be placed in apps/web or in any NEXT_PUBLIC_ variable.
