                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scoring Version"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
